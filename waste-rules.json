{
  "version": 1,
  "note": "Heuristics. Each flag is shown with its reason and confidence. Patterns are gitignore-style globs.",
  "protectedDirs": ["src", "app", "lib", "pages", "components", "server", "api", "tests", "test", "packages"],
  "rules": [
    { "id": "lockfiles", "category": "lockfile", "severity": "high", "confidence": "high",
      "patterns": ["package-lock.json", "yarn.lock", "pnpm-lock.yaml", "Cargo.lock", "poetry.lock", "Pipfile.lock", "composer.lock", "Gemfile.lock", "go.sum", "uv.lock"],
      "reason": "Machine-generated dependency graph. Huge in tokens, rarely useful to an AI assistant." },
    { "id": "build-output", "category": "build", "severity": "high", "confidence": "high",
      "patterns": ["dist/", "build/", "out/", ".next/", ".nuxt/", ".svelte-kit/", ".output/", "target/", "coverage/", ".turbo/", ".cache/"],
      "reason": "Generated build output. Duplicates your source in a harder-to-read form." },
    { "id": "vendored", "category": "dependencies", "severity": "high", "confidence": "high",
      "patterns": ["node_modules/", "vendor/", "third_party/", ".venv/", "venv/", "__pycache__/", ".gradle/", "Pods/"],
      "reason": "Third-party code you did not write. Assistants can look up libraries without indexing them." },
    { "id": "minified", "category": "minified", "severity": "high", "confidence": "high",
      "patterns": ["*.min.js", "*.min.css", "*.bundle.js", "*.chunk.js"],
      "reason": "Minified code is one giant line. Costs many tokens and is unreadable." },
    { "id": "sourcemaps", "category": "minified", "severity": "high", "confidence": "high",
      "patterns": ["*.map"],
      "reason": "Source maps are large generated JSON." },
    { "id": "large-data", "category": "data", "severity": "medium", "confidence": "medium", "minBytes": 102400,
      "patterns": ["*.json", "*.csv", "*.tsv", "*.ndjson", "*.jsonl", "*.sql", "*.xml", "*.yaml", "*.yml"],
      "reason": "Large data file (over 100 KB). Fixtures and dumps rarely need to be read whole. Check it is not a config you rely on." },
    { "id": "generated-code", "category": "generated", "severity": "medium", "confidence": "medium",
      "patterns": ["*.generated.*", "__generated__/", "*.pb.go", "*_pb2.py", "*.pb.ts", "*.snap", "*.d.ts.map"],
      "reason": "Generated code. Regenerated from a source of truth that is already in the repo." },
    { "id": "logs", "category": "logs", "severity": "medium", "confidence": "high",
      "patterns": ["*.log", "npm-debug.log*", "yarn-error.log*"],
      "reason": "Log output, not project knowledge." },
    { "id": "notebooks", "category": "notebooks", "severity": "medium", "confidence": "medium",
      "patterns": ["*.ipynb"],
      "reason": "Notebooks embed outputs and base64 images. Often far larger than their code." },
    { "id": "large-svg", "category": "assets", "severity": "medium", "confidence": "medium", "minBytes": 20480,
      "patterns": ["*.svg"],
      "reason": "SVGs are text, so they cost tokens, but they carry little meaning for code questions." },
    { "id": "fixtures", "category": "data", "severity": "low", "confidence": "low", "minBytes": 51200,
      "patterns": ["**/fixtures/**", "**/__fixtures__/**", "**/testdata/**", "**/mocks/data/**"],
      "reason": "Big test fixtures. Low confidence: you may want an assistant to see small ones." },
    { "id": "editor-files", "category": "editor", "severity": "low", "confidence": "medium",
      "patterns": [".idea/", ".DS_Store", "*.swp"],
      "reason": "Editor and OS files." }
  ],
  "alwaysSkipExtensions": ["png", "jpg", "jpeg", "gif", "webp", "ico", "pdf", "zip", "gz", "tar", "mp4", "mov", "mp3", "wav", "woff", "woff2", "ttf", "eot", "otf", "exe", "dll", "so", "dylib", "bin", "class", "jar", "wasm", "lockb"]
}
